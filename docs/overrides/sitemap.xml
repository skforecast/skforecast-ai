{#-
  Sitemap of MkDocs (mkdocs/templates/sitemap.xml) without the pages kept only
  to redirect old links (template: redirect.html). They carry noindex, and a
  sitemap that lists them makes Search Console report "Submitted URL marked
  noindex". The rest is the template of MkDocs 1.6, unchanged.
-#}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for file in pages -%}
    {% if not file.page.is_link and (file.page.abs_url or file.page.canonical_url) and file.page.meta.template != "redirect.html" %}
    <url>
         <loc>{% if file.page.canonical_url %}{{ file.page.canonical_url|e }}{% else %}{{ file.page.abs_url|e }}{% endif %}</loc>
         {% if file.page.update_date %}<lastmod>{{file.page.update_date}}</lastmod>{% endif %}
    </url>
    {%- endif -%}
{% endfor %}
</urlset>
